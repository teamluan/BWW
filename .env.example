DISCORD_TOKEN=DEIN_BOT_TOKEN

# Supabase — server-only secret key; NIEMALS ins Repository committen
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Auto-Update (sync.js) — true aktiviert das automatische Aktualisieren
AUTO_UPDATE=true
# Prüf-Intervall in Millisekunden (Standard: 120000 = 2 Minuten)
AUTO_UPDATE_INTERVAL_MS=120000

# Optional: Discord-Webhook für Sync-/Bot-Logs
# LOG_WEBHOOK_URL=https://discord.com/api/webhooks/...
# LOG_WEBHOOK_LEVEL=info
