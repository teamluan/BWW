DISCORD_TOKEN=DEIN_BOT_TOKEN

# Auto-Update (sync.js) — true aktiviert das automatische Aktualisieren
AUTO_UPDATE=true
# Prüf-Intervall in Millisekunden (Standard: 120000 = 2 Minuten)
AUTO_UPDATE_INTERVAL_MS=120000

# Optional: Discord Webhook für Sync-Logs (alle sync.js + Bot Logs)
LOG_WEBHOOK_URL=https://discord.com/api/webhooks/DEINE_ID/DEIN_TOKEN
LOG_WEBHOOK_LEVEL=info  # info | warn | error
